#!/usr/bin/env python3
"""dx: controlla Devtox dal terminale tramite il socket Unix locale.

  dx                              avvia Devtox (o porta in primo piano la finestra aperta)
  dx open <indirizzo o ricerca>   apre una nuova tab
  dx tabs                         elenca le tab
  dx mem                          memoria dei processi del browser
  dx servers                      server di sviluppo in ascolto su questo PC
  dx stop <porta...> | all        ferma i server (SIGTERM, come Ctrl+C)
"""

import argparse
import json
import os
import shutil
import socket
import subprocess
import sys

APP_ID = "devtox"

# dx resta un file solo, senza GTK: le poche frasi tradotte stanno qui
MESSAGES_EN = {
    "Controlla Devtox.": "Control Devtox.",
    "apre un indirizzo o una ricerca in una nuova tab": "open an address or a search in a new tab",
    "elenca le tab aperte": "list open tabs",
    "mostra la memoria usata dal browser": "show the browser's memory use",
    "dx: Devtox non è in esecuzione (socket non trovato)": "dx: Devtox is not running (socket not found)",
    "risposta non valida": "invalid response",
    "aperto": "opened",
    "terminale": "terminal",
    "Senza argomenti avvia Devtox, o porta in primo piano la finestra già aperta.":
        "With no arguments, start Devtox or bring the open window forward.",
    "dx: comando devtox non trovato: esegui install.sh": "dx: devtox command not found: run install.sh",
    "Devtox avviato": "Devtox started",
    "ferma i server di sviluppo (SIGTERM, come Ctrl+C)": "stop development servers (SIGTERM, like Ctrl+C)",
    "porte da fermare, oppure all": "ports to stop, or all",
    "fermato": "stopped",
    "server di sviluppo in ascolto su questo PC": "development servers listening on this machine",
    "nessun server in ascolto su localhost": "no server listening on localhost",
}


def language():
    """Stessa scelta del browser: "language" in config.json, poi le variabili di sistema."""
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")
    try:
        with open(os.path.join(base, APP_ID, "config.json"), encoding="utf-8") as f:
            configured = json.load(f).get("language", "")
    except (OSError, ValueError, AttributeError):
        configured = ""
    if configured in ("it", "en"):
        return configured
    for name in ("LANGUAGE", "LC_ALL", "LC_MESSAGES", "LANG"):
        code = os.environ.get(name, "").split(":")[0].split("_")[0].split(".")[0].lower()
        if code and code not in ("c", "posix"):
            return "it" if code == "it" else "en"
    return "en"


def _(text):
    return MESSAGES_EN.get(text, text) if LANGUAGE == "en" else text


def socket_path():
    if os.environ.get("DEVTOX_SOCKET"):
        return os.environ["DEVTOX_SOCKET"]
    runtime = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    return os.path.join(runtime, APP_ID + ".sock")


def send(request, missing_ok=False):
    """Risposta del browser; con missing_ok=True None se Devtox non è aperto."""
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
        sock.settimeout(5)
        try:
            sock.connect(socket_path())
        except OSError:
            if missing_ok:
                return None
            sys.exit(_("dx: Devtox non è in esecuzione (socket non trovato)"))
        sock.sendall((json.dumps(request) + "\n").encode())
        data = b""
        while not data.endswith(b"\n"):
            chunk = sock.recv(65536)
            if not chunk:
                break
            data += chunk
    response = json.loads(data or b"{}")
    if not response.get("ok"):
        sys.exit(f"dx: {response.get('error', _('risposta non valida'))}")
    return response


def launch():
    """Avvia Devtox staccato dal terminale: il prompt torna subito libero."""
    here = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    if shutil.which("devtox"):
        command, env = ["devtox"], None
    elif os.path.isdir(os.path.join(here, "devtox")):
        # Da un clone del progetto: il pacchetto sta accanto a bin/
        command = [sys.executable, "-m", "devtox"]
        env = dict(os.environ, PYTHONPATH=here + os.pathsep + os.environ.get("PYTHONPATH", ""))
    else:
        sys.exit(_("dx: comando devtox non trovato: esegui install.sh"))
    subprocess.Popen(command, env=env, cwd=os.path.expanduser("~"), stdin=subprocess.DEVNULL,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    print(_("Devtox avviato"))


def mb_size(kb):
    return f"{kb / 1024:.1f} MB"


def main():
    parser = argparse.ArgumentParser(
        prog="dx", description=_("Controlla Devtox.") + " "
        + _("Senza argomenti avvia Devtox, o porta in primo piano la finestra già aperta."))
    sub = parser.add_subparsers(dest="cmd")
    open_parser = sub.add_parser("open", help=_("apre un indirizzo o una ricerca in una nuova tab"))
    open_parser.add_argument("target", nargs="+")
    sub.add_parser("tabs", help=_("elenca le tab aperte"))
    sub.add_parser("mem", help=_("mostra la memoria usata dal browser"))
    sub.add_parser("servers", help=_("server di sviluppo in ascolto su questo PC"))
    stop_parser = sub.add_parser("stop", help=_("ferma i server di sviluppo (SIGTERM, come Ctrl+C)"))
    stop_parser.add_argument("ports", nargs="+", help=_("porte da fermare, oppure all"))
    args = parser.parse_args()

    if args.cmd is None:
        if send({"cmd": "present"}, missing_ok=True) is None:
            launch()
    elif args.cmd == "open":
        response = send({"cmd": "open", "url": " ".join(args.target)})
        print(f"{_('aperto')}: {response['url']}")
    elif args.cmd == "tabs":
        for tab in send({"cmd": "tabs"})["tabs"]:
            marks = ("*" if tab["current"] else " ") + ("z" if tab["suspended"] else " ")
            print(f"{tab['index']:>3} {marks} {tab['title'][:50]:<50}  {tab['uri'] or ''}")
    elif args.cmd == "servers":
        servers = send({"cmd": "servers"})["servers"]
        if not servers:
            print(_("nessun server in ascolto su localhost"))
        for server in servers:
            print(f"{server['port']:>6}  {server['tool'] or '-':<12} {server['project'] or '-':<36} {server['uptime']}")
    elif args.cmd == "stop":
        if args.ports == ["all"]:
            ports = "all"
        else:
            try:
                ports = [int(p.lstrip(":")) for p in args.ports]
            except ValueError:
                parser.error(_("porte da fermare, oppure all"))
        response = send({"cmd": "stop", "ports": ports})
        for server in response["stopped"]:
            print(f"{_('fermato')}: {server['port']:>6}  {server['tool'] or '-'}")
        for item in response["errors"]:
            print(f"dx: {item['port']}: {item['error']}", file=sys.stderr)
    elif args.cmd == "mem":
        response = send({"cmd": "mem"})
        for proc in sorted(response["processes"], key=lambda p: -p["pss_kb"]):
            print(f"{proc['pid']:>8}  {proc['kind']:<12} {proc['name']:<18} {mb_size(proc['pss_kb']):>10}")
        print(f"\nbrowser: {mb_size(response['browser_kb'])}   "
              f"{_('terminale')}: {mb_size(response['terminal_kb'])}")


LANGUAGE = language()

if __name__ == "__main__":
    main()
